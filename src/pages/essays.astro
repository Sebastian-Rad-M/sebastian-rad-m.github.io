---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import EssayCard from '../components/EssayCard.astro';
import Divider from '../components/Divider.astro';

const allEssays = await getCollection('essays');
const sortedEssays = allEssays.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Essays | Hem of the Garment" description="All my non-Comp-Sci projects and essays.">
    <main class="animate-fade-in-up">
        <div class="title animate-fade-in-up delay-100">
            <span>Essays</span>
        </div>
        
        <div class="essays-section">
            <Divider color='rgba(var(--textcol-rgb), 0.15)' className="divInFE animate-fade-in-up delay-200" />
            
            {sortedEssays.map((essay, index) => (
                <div class="essay-item" style={`animation-delay: ${200 + index * 100}ms`}>
                    <EssayCard 
                        title={essay.data.title}
                        date={essay.data.pubDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}
                        description={essay.data.description}
                        url={`/essays/${essay.id}`}
                    />
                    <Divider color='rgba(var(--textcol-rgb), 0.15)' className="divInFE" />
                </div>
            ))}
        </div>
    </main>
</Layout>

<style>
    main {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: 2rem;
        align-items: start;
        grid-auto-flow: row dense;
        padding-bottom: 5rem;
    }
    .title {
        grid-column: 1 / span 12; 
        padding-left: 3rem;
        padding-bottom: 2rem;
        font-size: clamp(6rem, 8vw, 10rem);
        display: flex;
        flex-direction: column;
        gap: 0;
        line-height: 0.95;
        color: var(--textcol);
        text-shadow: 0 4px 20px rgba(var(--maincol-rgb), 0.15);
    }
    
    .essays-section {
        grid-column: 1 / -1;
        margin-left: 3rem;
        margin-right: 3rem;
        margin-top: 2rem;
    }

    .essay-item {
        animation: fadeInUp 0.8s var(--transition-slow) forwards;
        opacity: 0;
    }

    .divInFE {
        margin-left: 0;
        margin-right: 0;
    }
</style>