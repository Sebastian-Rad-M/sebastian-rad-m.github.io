<script>
  function invertColors(element: HTMLElement | null): void {
    if (!element) return;
    const computed = window.getComputedStyle(element);
    const currentBg = element.style.backgroundColor || computed.backgroundColor;
    const currentColor = element.style.color || computed.color;

    element.style.backgroundColor = currentColor;
    element.style.color = currentBg;
  }

  function invertOnInterval(element: HTMLElement | null, intervalMs: number = 1000): number | null {
    if (!element) return null;
    return window.setInterval(() => invertColors(element), intervalMs);
  }

  function invertOnHover(element: HTMLElement | null): void {
    if (!element) return;
    element.addEventListener('mouseenter', () => invertColors(element));
    element.addEventListener('mouseleave', () => invertColors(element));
  }

  document.querySelectorAll<HTMLElement>('.tos-menubar span').forEach((item) => {
    invertOnHover(item);
  });

  const menuLabel = document.querySelector<HTMLElement>('.border-label.top-left');

  document.querySelectorAll<HTMLElement>('.blinker').forEach((item) => {
  invertOnInterval(item, 300);
  });
    
const terminalInput = document.getElementById('terminal-input') as HTMLInputElement | null;
  const inputDisplay = document.getElementById('input-display') as HTMLSpanElement | null;
  const mainContainer = document.querySelector('.main') as HTMLElement | null;
  const terminalScroll = document.getElementById('terminal-scroll') as HTMLElement | null;

  if (terminalInput && inputDisplay && mainContainer && terminalScroll) {
    
    terminalInput.addEventListener('input', (e: Event) => {
      const target = e.target as HTMLInputElement;
      inputDisplay.textContent = target.value;
    });

    // Focus the hidden input if the user clicks anywhere inside the terminal box
    mainContainer.addEventListener('click', () => {
      terminalInput.focus();
    });

    terminalInput.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter') {
        e.preventDefault(); 
        
        const rawInput = terminalInput.value;
        const command = rawInput.trim();
        const inputLine = terminalInput.parentElement as HTMLElement;

        const historyLine = document.createElement('div');
        historyLine.className = 'line';
        historyLine.textContent = `T:> ${rawInput}`; 
        terminalScroll.insertBefore(historyLine, inputLine);

        if (command.length > 0) {
          const responseLine = document.createElement('div');
          
          responseLine.className = 'line'; 
          responseLine.style.color = 'var(--blue)'; 
          const cmdLower = command.toLowerCase();

          if (cmdLower === 'philosophy') {
            responseLine.textContent = 'it is theology, but that doesnt look the best on my resume. what i mean by it is filioque, ads and diffrent debates i find intresting intelectually, not religious fanaticism';
          } 
          else if (cmdLower === 'glow') {
             
              responseLine.textContent = 'You can see them if you\'re driving. You just run them over.';
              responseLine.style.color = 'var(--light-green)'; 
            }
          else if (cmdLower === 'clear') {
            const allLines = terminalScroll.querySelectorAll('.line');
            allLines.forEach(line => {
              if (line !== inputLine) line.remove();
            });
            responseLine.textContent = ''; 
          } 
          else {
             responseLine.textContent = `&LexExcept &PrsStmt &LexStmt2Bin ERROR: Undefined identifier at "${command}" ~/Tmp.DD.Z.0003~/Tmp.DD.Z,3`;
          }

          if (responseLine.textContent !== '') {
            terminalScroll.insertBefore(responseLine, inputLine);
          }
        }

        // 3. Reset input
        terminalInput.value = '';
        inputDisplay.textContent = '';

        // 4. Scroll to bottom of the new scroll container
        terminalScroll.scrollTop = terminalScroll.scrollHeight;
      }
    });
  }
</script>
