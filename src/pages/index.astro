---
import Layout from '../layouts/Layout.astro';
import EssayCard from '../components/EssayCard.astro';
import Divider from '../components/Divider.astro';
import { Image } from 'astro:assets';
import paradiseL from '../assets/siene.png';  
---
<Layout title="Hem of the Garment" description="">
     <main>
        <div class="title"><span>Hem</span> 
            <span>of the</span> 
            <span>Garment</span>   
        </div>
        <Image src={paradiseL} alt="" class="photo1" />
        
        <div class="p right">
            This is where I keep my non-Comp-Sci projects. Enjoy a royalty free photo of Seine. 
            <div class="small"> No creative work on any of these pages has been done with any help from AI.</div>
        </div>

        <div class="featured-section">
             <h2>Featured essay:</h2>
            <Divider color='#9998a5' className="divInFE" />
            <EssayCard 
                title="An archetypal analysis of Heathers, The Musical"
                date="January 2026"
                description="bla bla"
                url="/essays/heathers"
            />
        </div>
            </main>
</Layout>

<style>
    main{
         display: grid;
         grid-template-columns: repeat(12, 1fr);
         gap: 0.2rem;
         align-items: start;
         grid-auto-flow: row dense;
        }
    .title{
            grid-column: 1;
            padding-left: 3rem ;
            padding-bottom: 3rem;
            font-size:7rem;
            display: flex;
            flex-direction: column;
            gap: 0rem;
            line-height:0.95;
          }
    .photo1{
    grid-column: 7/ -1;
    width: 100%;   
    height: auto; 
    object-fit: cover;
    margin-top: -2.5rem;
    }
    .right{
    margin-top: 3rem;
    grid-column: 7/ -1;
    text-align: left;
    margin-right: 3rem;
    
    .small {
        font-size: 1.3rem;      
        line-height: 1.5;
        color: var(--accent1);
        opacity: 0.8;     
        margin-top: 0.3rem;     
        font-style: italic;     
    }
    
    }
    .featured-section {
    grid-column: 1/ -1;
    margin-left: 3rem;
    margin-top: 3rem;
    .divInFE {
            margin-left: -2rem;
    }
    }

</style>

