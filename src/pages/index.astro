    </main>
</Layout>

<style>
    main{
         display: grid;
         grid-template-columns: repeat(12, 1fr);
          gap: 0.2rem;
      align-items: start;
      grid-auto-flow: row dense;
    }
    .title{
    grid-column: 1;
    padding-left: 3rem ;
    padding-bottom: 3rem;
    font-size:7rem;
    display: flex;
    flex-direction: column;
    gap: 0rem;
    line-height:0.95;
    }
    .photo1{
    grid-column: 7/ -1;
    width: 100%;   
    height: auto; 
    object-fit: cover;
    margin-top: -2.5rem;
    /*border-left: 0.1rem solid var(--accent1);*/
}
    .right{
    margin-top: 5rem;
    grid-column: 7/ -1;
    text-align: right;
    margin-right: 3rem;
    }

</style>

