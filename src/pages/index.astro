---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import paradiseL from '../assets/siene.png';  
---
<Layout title="Hem of the Garment" description="">
     <main>
        <div class="title"><span>Hem</span> 
            <span>of the</span> 
            <span>Garment</span>   
        </div>
        <Image src={paradiseL} alt="" class="photo1" />
        
        <div class="p right">This is the place where i put out my humanities related work.Being a Comp-Sci student doesnt allow me to express too much creativity, so i do essays for fun sometimes. Here you will find the ones i deem acceptable for the light of day.</div>
