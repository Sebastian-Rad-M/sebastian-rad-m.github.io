---
const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '/index.html' || pathname === '/index.astro';
---

<nav class="animate-fade-in">
    <div class="nav-content">
        { !isHome && (
            <div class="titlecard">
                <a href="/">Hem of the Garment</a>
            </div>
        )}
        
        <div class="menu">
            <a href="/essays" class="nav-link">Essays</a>
            <a href="/" class="nav-link">About</a>
            <a href="/contact" class="nav-link last">Contact</a>
        </div>
    </div>
    <div class="divider"></div>
</nav>

<style>
    nav {
        padding: 1.5rem 0 0 0;
        position: sticky;
        top: 0;
        z-index: 100;
        background: linear-gradient(to bottom, rgba(var(--bgcol-rgb), 0.95) 20%, rgba(var(--bgcol-rgb), 0.7) 80%, transparent);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
    }
    .nav-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .titlecard {
        padding-left: 3rem;
        height: 40px;
        margin-top: -10px;
    }
    
    .titlecard a {
        font-size: 2.4rem;
        text-decoration: none;
        color: var(--maincol);
        transition: color var(--transition-fast);
        opacity: 0.9;
    }

    .titlecard a:hover {
        color: var(--highlight1);
        opacity: 1;
    }

    .menu {
        padding: 0 2rem;
        margin-left: auto;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 30px;
        height: 40px;
        margin-top: -10px;
    }

    .nav-link {
        font-size: 1.6rem;
        font-style: italic;
        text-decoration: none;
        color: var(--textcol);
        position: relative;
        padding: 0.5rem 0;
        transition: color var(--transition-fast);
        opacity: 0.8;
    }

    .nav-link:hover {
        opacity: 1;
        color: var(--maincol);
    }

    .nav-link::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 0;
        height: 1px;
        background-color: var(--maincol);
        transition: width var(--transition-fast);
    }

    .nav-link:hover::after {
        width: 100%;
    }
    
    .last {
        margin-right: 50px;
    }

    .divider {
        margin-top: 1.5rem;
        margin-bottom: 0;
        opacity: 0.5;
    }
</style>
