---
interface Props {
    title: string;
    date: string;
    description: string;
    url: string;
}

const { title, date, description, url } = Astro.props;
---
<a href={url} class="essay-link animate-fade-in-up delay-100">
    <div class="essay">
        <h3 class="essay-title">{title}</h3>
        <div class="essay-date">{date}</div>
        <p class="essay-desc">{description}</p>
    </div>
</a>

<style>
    .essay-link {
        text-decoration: none !important;
        color: inherit;
        display: block;
        transition: transform var(--transition-slow), opacity var(--transition-slow);
        position: relative;
    }
    
    .essay-link::before {
        content: '';
        position: absolute;
        top: 0; left: -1rem; right: -1rem; bottom: 0;
        background: linear-gradient(90deg, transparent, rgba(var(--maincol-rgb), 0.03), transparent);
        opacity: 0;
        border-radius: 8px;
        transition: opacity var(--transition-slow);
        z-index: -1;
    }

    .essay-link:hover {
        transform: translateX(10px);
    }

    .essay-link:hover::before {
        opacity: 1;
    }

    .essay {
        padding: 1.5rem 0;
    }
    .essay-title {
        font-size: 2.6rem;
        font-weight: normal;
        color: var(--maincol);
        transition: color var(--transition-fast), text-shadow var(--transition-fast);
        margin-bottom: 0.5rem;
    }
    
    .essay-link:hover .essay-title {
        color: var(--highlight1);
        text-shadow: 0 0 15px rgba(var(--highlight1-rgb), 0.3);
    }

    .essay-date {
        font-size: 1.4rem;
        color: var(--accent1);
        font-style: italic;
        margin-bottom: 1rem;
        opacity: 0.7;
        letter-spacing: 0.5px;
    }
    .essay-desc {
        font-size: 1.7rem;
        line-height: 1.6;
        margin: 0;
        color: var(--textcol);
        opacity: 0.9;
    }
</style>
