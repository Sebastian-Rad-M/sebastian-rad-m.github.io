---
import Divider from './Divider.astro';

const year = new Date().getFullYear();
---
<footer>
    <Divider />
    <div class="footer-content">
        <p> {year} Sebastian Rad. Built with Astro.</p>
    </div>
</footer>

<style>
    footer {
        margin-top: 4rem;
        padding-bottom: 2rem;
        width: 100%;
    }
    .footer-content {
        text-align: center;
        padding: 0 2rem;
    }
    p {
        font-size: 1.2rem;
        color: var(--accent1);
        opacity: 0.7;
        margin: 0;
    }
</style>
